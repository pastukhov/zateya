[Unit]
Description=Zateya voice gateway and Codex agent (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/opt/zateya

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/zateya
ExecStartPre=/usr/bin/test -f /opt/zateya/.env
ExecStartPre=/usr/bin/test -d /opt/zateya/data/obsidian/.git
ExecStartPre=/usr/bin/docker compose -p zateya config --quiet
ExecStart=/usr/bin/docker compose -p zateya up -d --no-build --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose -p zateya stop -t 30
TimeoutStartSec=240
TimeoutStopSec=60
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
