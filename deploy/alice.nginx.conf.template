# HTTPS terminates on Keenetic. Only the Alice POST endpoint is public.
limit_req_zone $server_name zone=alice_ingress:1m rate=10r/s;
log_format alice_safe '$status $request_method $request_time';
server {
    listen 8080;
    server_name _;
    server_tokens off;
    access_log /dev/stdout alice_safe;
    # Request parsing errors may contain raw headers; suppress these logs.
    error_log /dev/stderr crit;
    client_max_body_size 64k;
    client_body_timeout 3s;
    client_header_timeout 3s;
    send_timeout 3s;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 1s;
    location = /api/alice/webhook {
        if ($request_method != POST) { return 405; }
        limit_req zone=alice_ingress burst=30 nodelay;
        limit_req_status 429;
        set $alice_backend backend:${VOICE_BIND_PORT};
        proxy_pass http://$alice_backend;
        proxy_connect_timeout 1s;
        proxy_read_timeout 3s;
        proxy_send_timeout 3s;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        # Do not forward untrusted client-supplied source addresses.
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
    }
    location / { return 404; }
}
