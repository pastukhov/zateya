# Пример переменных окружения Voice Gateway (скопируйте в .env рядом с docker-compose.yml).
# Значения по умолчанию безопасны: без ключей навык Алисы отключён (ALICE_ENABLED=false).

# --- Голосовой шлюз ---
VOICE_BIND_HOST=0.0.0.0
VOICE_BIND_PORT=8080
VOICE_DEVICE_TOKENS={"001122334455":"замена-на-реальный-токен"}
VOICE_API_KEY=
VOICE_AUTH_ENABLED=
VOICE_RATE_LIMIT=100
VOICE_RATE_PERIOD=60
USAGE_PRICING_PATH=/data/archive/pricing.json

# --- LLM ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_RESPONSE_FORMAT=text
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=8192
LLM_HISTORY_TURNS=6
LLM_HISTORY_MAX_CHARS=12000

# --- STT/TTS (аудиоканал диктофона) ---
STT_MODEL=
STT_TIMEOUT=60
TTS_MODEL=
TTS_RESPONSE_FORMAT=wav
TTS_VOICE=
TTS_TIMEOUT=60

# --- Знания и vault ---
VOICE_KNOWLEDGE_ENABLED=true
OBSIDIAN_VAULT_PATH=/data/obsidian
GIT_AUTHOR_NAME=Затея
GIT_AUTHOR_EMAIL=zateya@localhost

# --- Навык Алисы (план 2026-09-27, задачи 4–6) ---
# Включать только после настройки навыка, Яндекс ID и HTTPS-маршрута.
# ALICE_SKILL_ID — ID из консоли Яндекс Диалогов.
# ALICE_ALLOWED_YANDEX_ID — id владельца из GET https://login.yandex.ru/info (не user_id из webhook!).
# ALICE_CONTEXT_DEVICE_ID — существующий device_id диктофона: общая история и последняя идея.
# База очереди выводится из ARCHIVE_ROOT: data/archive/alice.sqlite3 (отдельная настройка не нужна).
ALICE_ENABLED=false
ALICE_SKILL_ID=
ALICE_ALLOWED_YANDEX_ID=
ALICE_CONTEXT_DEVICE_ID=

# KeenDNS -> server:7071 -> Alice-only proxy. Enables proxy in systemd Compose too.
# Set COMPOSE_PROFILES=alice after configuring KeenDNS.
COMPOSE_PROFILES=
ALICE_PROXY_BIND_HOST=0.0.0.0
ALICE_PROXY_PORT=7071
