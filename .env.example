# Zateya gateway. Copy to .env; never commit real credentials.

# Compose user for mounted state. prepare-data.sh reads the rendered UID:GID.
ZATEYA_UID=1000
ZATEYA_GID=1000

# Gateway bind and LLM Chat Completions endpoint.
VOICE_BIND_HOST=0.0.0.0
VOICE_BIND_PORT=8080
# OpenRouter: https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Budget default: Qwen3.7 Flash ($0.03/M input, $0.13/M output on 2026-09-26).
LLM_MODEL=qwen/qwen3.7-flash
LLM_RESPONSE_FORMAT=json_object
# Higher-quality alternative to compare on real dictations (more expensive):
# LLM_MODEL=qwen/qwen3.8-flash
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=8192
LLM_HISTORY_TURNS=6
LLM_HISTORY_MAX_CHARS=12000

# STT uses LLM_BASE_URL + /audio/transcriptions.
STT_MODEL=openai/whisper-1
STT_TIMEOUT=60
# TTS uses LLM_BASE_URL + /audio/speech. Grok supports WAV and Russian; Eve is the feminine voice.
TTS_MODEL=x-ai/grok-voice-tts-1.0
TTS_VOICE=eve
TTS_INSTRUCTIONS=
TTS_TIMEOUT=60

# One distinct bearer token per device, mapped by its stable device ID.
# Example only: {"sticks3-a1b2c3":"replace-with-device-token"}
VOICE_DEVICE_TOKENS=
VOICE_API_KEY=
VOICE_AUTH_ENABLED=
VOICE_RATE_LIMIT=100
VOICE_RATE_PERIOD=60

# The Compose file mounts these local folders inside the gateway.
VOICE_KNOWLEDGE_ENABLED=true
OBSIDIAN_INBOX=Voice Inbox
NOTE_INCLUDE_TRANSCRIPT=false

# Git identity for asynchronous Obsidian commits. SSH key/known_hosts go in data/ssh.
GIT_AUTHOR_NAME=Затея
GIT_AUTHOR_EMAIL=zateya@localhost
GIT_COMMITTER_NAME=Затея
GIT_COMMITTER_EMAIL=zateya@localhost

LOG_LEVEL=INFO
LOG_TRANSCRIPT=false
